# Low-sensitivity staging settings, appended verbatim to the generated .env by deploy.sh.
# Secrets (SECRET_KEY / POSTGRES_PASSWORD / SMTP2GO_API_KEY / KOTSMS_*) come from GCP Secret Manager —
# never here. SMS_PROVIDER is written by gen_env too, next to the KotSMS credentials it depends on.
ENV=staging
EMAIL_PROVIDER=smtp2go
EMAIL_FROM=no-reply@wan-guard.com
EMAIL_FROM_NAME=島嶼守望
GOOGLE_CLIENT_ID=717563375943-pibc1j3tdeb6oq4tn7hp3tt78otlgrsj.apps.googleusercontent.com
LINE_CHANNEL_ID=2010287145
APP_BASE_URL=https://staging.wan-guard.com
PHONE_DEFAULT_REGION=TW

# --- Sign-in cookies and OAuth (ADR-326, ADR-327, ADR-331) — the frontend reads AUTH_COOKIE_PREFIX too ---
# The back office is admin-staging, one level deep: Cloudflare's free certificate covers no deeper host.
AUTH_COOKIE_PREFIX=wgstg
AUTH_COOKIE_DOMAIN=.wan-guard.com
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=https://staging.wan-guard.com,https://admin-staging.wan-guard.com
SITE_APP_URL=https://staging.wan-guard.com
ADMIN_APP_URL=https://admin-staging.wan-guard.com
OAUTH_REDIRECT_BASE_URL=https://staging.wan-guard.com

# --- Frontend (Next.js) — non-secret config (secrets come from Secret Manager via gen_env) ---
NEXTAUTH_URL=https://demo.wan-guard.com
# Frontend → backend over the internal docker network (never the public URL).
API_BASE_URL=http://backend:8000/api
GRAPHQL_URL=http://backend:8000/graphql
# LINE client id for the frontend's NextAuth provider (same value as LINE_CHANNEL_ID above).
LINE_CLIENT_ID=2010287145
