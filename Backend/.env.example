# ==========================================================================================================
# Backend env for local development: copy this file to Backend/.env (read by app/core/config.py)
# ==========================================================================================================
# You can run the backend WITHOUT any GCP access: every value below is either a working local default or
# something you generate yourself. GCP is only needed for the optional parts: real email, Google and LINE.
#
# Values marked  [GCP: <secret-name>]  live in GCP Secret Manager, project `wanguard-250923`. Fetch one with:
#   gcloud secrets versions access latest --project=wanguard-250923 --secret=<secret-name>
# Reading them needs `roles/secretmanager.secretAccessor` on that project; ask the team to grant it.
#
# Never copy these staging secrets into a local file, even though they are in Secret Manager:
#   staging-backend-jwt-signing-key     whoever holds it can sign a login token for ANY staging user
#   staging-backend-postgres-password   the staging DB password; useless against your local DB
#   staging-cloudflared-tunnel-token    would attach your machine to the public staging tunnel
#
# Never commit Backend/.env (it is in .gitignore). The repo is PUBLIC.
# ==========================================================================================================

# --- Database / Redis ---------------------------------------------------------------------------------------
# Matches the dev containers from `docker compose up -d db redis` (user/password postgres/postgres).
# When the backend itself runs in docker compose, docker-compose.yml overrides these two with the in-network
# hostnames (db / redis), so these values only matter when you run uvicorn on the host.
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# --- JWT signing key ----------------------------------------------------------------------------------------
# Any string works locally. Do NOT use staging-backend-jwt-signing-key (see the warning at the top).
SECRET_KEY=your-secret-key-for-local-dev

# --- Email (sign-up / OTP codes) ----------------------------------------------------------------------------
# `console` prints the email, including the verification code, to the backend log. Enough for local work.
EMAIL_PROVIDER=console
# Optional: to send real email, switch the provider and fill in the key:
#   EMAIL_PROVIDER=smtp2go
#   SMTP2GO_API_KEY=                     [GCP: staging-backend-smtp2go-api-key]
EMAIL_FROM=no-reply@wan-guard.com
EMAIL_FROM_NAME=島嶼守望

# --- SMS (phone OTP codes) ----------------------------------------------------------------------------------
# Keep `console`: the code is printed to the backend log.
# The real provider (KotSMS / 簡訊王) only accepts requests from the staging VM's static IP, so it fails from
# your machine even with valid credentials. For reference only; leave these empty locally:
#   KOTSMS_USERNAME=                     [GCP: staging-backend-kotsms-username]
#   KOTSMS_PASSWORD=                     [GCP: staging-backend-kotsms-password]
SMS_PROVIDER=console
PHONE_DEFAULT_REGION=TW

# --- Links in outgoing emails -------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# --- Sign-in cookies (Spec/023, ADR-326 and ADR-327) --------------------------------------------------------
# Every sign-in cookie is named with this prefix (wgdev_at, wgdev_rt, wgdev_oauth). It must equal
# AUTH_COOKIE_PREFIX in Frontend/.env.local.
AUTH_COOKIE_PREFIX=wgdev
# Empty: the cookies stay on the one host, localhost. Staging and production set the parent domain of their
# site and back-office hosts.
AUTH_COOKIE_DOMAIN=
# Local development is plain http. The default, true, marks the cookies Secure, which is for https.
AUTH_COOKIE_SECURE=false
# The pages allowed to send a write signed in by the cookie: the site and the back office as you run them.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Google / LINE sign-in (optional; Spec/023, ADR-331) ----------------------------------------------------
# Only needed to test "Sign in with Google / LINE"; email/password sign-in works without them. The backend
# runs the whole sign-in itself, so these are the only OAuth settings anywhere: the frontend has none.
# The client IDs are public identifiers, the same as in Backend/scripts/deploy-config.staging.env.
GOOGLE_CLIENT_ID=717563375943-pibc1j3tdeb6oq4tn7hp3tt78otlgrsj.apps.googleusercontent.com
# [GCP: staging-backend-google-client-secret]   Left empty, "Sign in with Google" is refused at its start.
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=2010287145
# [GCP: staging-backend-line-channel-secret]    Left empty, "Sign in with LINE" is refused at its start.
LINE_CHANNEL_SECRET=
# Where a sign-in sends the browser back to: the site and the back office as you run them.
SITE_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Google and LINE call back http://localhost:3000/api/v1/auth/oauth/<google|line>/callback, through the
# site's proxy. That exact URI must be registered on the Google / LINE client: if the provider answers
# `redirect_uri_mismatch` or a similar error, it is not, so ask the team.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
