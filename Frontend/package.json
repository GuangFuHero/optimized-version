{
  "name": "@rescue-frontend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:demo": "nx dev demo",
    "build:demo": "nx build demo",
    "start:demo": "nx start demo",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:watch": "nx test ui --configuration=watch",
    "affected:test": "nx affected -t test",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "reset": "nx reset",
    "codegen": "graphql-codegen --config libs/data-access/src/graphql/codegen.ts && pnpm codegen:admin && pnpm codegen:openapi && prettier --write libs/data-access/src/graphql/__generated__ libs/data-access/src/admin/graphql/__generated__ libs/data-access/src/rest/openapi.d.ts",
    "typecheck": "pnpm -r typecheck",
    "dev:ui": "nx dev ui",
    "dev:admin": "nx dev admin",
    "build:admin": "nx build admin",
    "start:admin": "nx start admin",
    "schemas:export": "cd ../Backend && PYTHONPATH=. ENV=testing uv run python scripts/export_frontend_schemas.py",
    "codegen:openapi": "pnpm --filter @rescue-frontend/data-access codegen:openapi",
    "schemas:generate": "pnpm schemas:export && pnpm codegen",
    "codegen:admin": "graphql-codegen --config libs/data-access/src/admin/graphql/codegen.ts"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/next": "^22.6.5",
    "@nx/react": "^22.6.5",
    "@nx/web": "22.6.5",
    "@nx/workspace": "22.6.5",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/geojson": "^7946.0.16",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/leaflet": "^1.9.14",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.6.5",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.1",
    "openapi-typescript": "^7.13.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0"
}
