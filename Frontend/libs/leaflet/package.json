{
  "name": "@rescue-frontend/leaflet",
  "version": "0.1.0",
  "description": "Headless React components for live Leaflet maps, drawing, editing, and undoable saves.",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry.ts",
    "./edit-sync": "./src/edit-sync.ts",
    "./labels": "./src/labels.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./geometry": {
        "types": "./dist/geometry.d.ts",
        "import": "./dist/geometry.js"
      },
      "./edit-sync": {
        "types": "./dist/edit-sync.d.ts",
        "import": "./dist/edit-sync.js"
      },
      "./labels": {
        "types": "./dist/labels.d.ts",
        "import": "./dist/labels.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuangFuHero/optimized-version.git",
    "directory": "Frontend/libs/leaflet"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/leaflet.markercluster": "^1.5.6",
    "leaflet.markercluster": "^1.5.3"
  },
  "peerDependencies": {
    "leaflet": ">=1.9.4 <2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
