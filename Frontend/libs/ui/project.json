{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": [
    "type:ui"
  ],
  "// targets": "to see all targets run: nx show project ui --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/ui/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest --config libs/ui/vitest.config.ts"
        }
      }
    }
  }
}
