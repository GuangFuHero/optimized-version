# ============================================================================================================
# The site's local env — copy to Frontend/.env.local (`pnpm dev:demo` loads it through Nx).
# The back office has its own: apps/admin/.env.example.
#
# Every value works as it is against a backend on localhost:8000; only the Google Maps key is optional.
# Never commit .env.local (it is in .gitignore): the repo is public.
# ============================================================================================================

# --- Backend URLs -------------------------------------------------------------------------------------------
# Where this app's server sends the browser's requests on.
# GRAPHQL_URL is derived from API_BASE_URL when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
API_BASE_URL=http://localhost:8000/api
GRAPHQL_URL=http://localhost:8000/graphql

# --- Login cookies ------------------------------------------------------------------------------------------
# Signing in — password, Google, LINE — is the backend's: it sets the login cookies, and the site holds no
# login secret of its own. Google and LINE are set up in the backend's env only.
# The cookies' name prefix must equal the backend's AUTH_COOKIE_PREFIX (wgdev locally, wgstg on staging, wg in
# production): the proxy and the middleware only read and forward cookies with this prefix.
AUTH_COOKIE_PREFIX=wgdev
